<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Personicore.DeviceAgent.Mac</RootNamespace>
    <AssemblyName>PersonicoreDeviceAgent</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <Company>Personicore</Company>
    <Product>Personicore Device Agent</Product>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../core/Personicore.DeviceAgent.Core/Personicore.DeviceAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same mark silhouettes as Windows (generated by windows/build/make-icon.py). -->
    <EmbeddedResource Include="../../../windows/src/Personicore.DeviceAgent/Resources/mark-*.png"
                      LogicalName="%(Filename)%(Extension)" />

    <!-- The root helper that changes the system proxy; installed on first use. -->
    <EmbeddedResource Include="../../helper/proxy-helper.sh" LogicalName="proxy-helper.sh" />
  </ItemGroup>

</Project>
